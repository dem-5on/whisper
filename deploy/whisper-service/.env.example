# Wicx hosted service -- example environment file.
#
# Copy to `.env` (or to a 0600 file outside the repository and point the unit's
# `EnvironmentFile=` at it) and fill in only what you run. Values already present
# in the real environment always win, so this file fills gaps and never
# overrides an operator export.
#
#   cp deploy/whisper-service/.env.example deploy/whisper-service/.env
#   chmod 600 deploy/whisper-service/.env
#
# Never commit the filled-in file: `.env` is git-ignored and a test enforces it.
# Keep one env file per application on a shared host so no app can read another
# app's secrets. Every variable below is prefixed WHISPER_ or WICX_, which is
# what keeps them namespaced per app.

# ---------------------------------------------------------------------------
# Loader
# ---------------------------------------------------------------------------
# Optional. Point at a specific env file instead of using ./.env. Read before the
# file it names, so set it in the real environment or the unit, not in here.
# WHISPER_ENV_FILE=/etc/wicx/whisper-service.env

# ---------------------------------------------------------------------------
# Feature toggles (off unless set)
# ---------------------------------------------------------------------------
# Speaker analysis endpoint: POST/GET/DELETE /v1/diarization/jobs
WHISPER_ENABLE_DIARIZATION=0
# Post-session analysis endpoint: POST /v1/analysis, GET /v1/analysis/kinds
WHISPER_ENABLE_ANALYSIS=0
# Dictation text rewriting: POST /v1/rewrite
WHISPER_ENABLE_REWRITE=0
# Paystack subscriptions, checkout, and cloud-minute metering
WHISPER_ENABLE_BILLING=0
# Google/Apple sign-in so entitlements follow an account instead of a manual grant
WHISPER_ENABLE_OAUTH=0

# ---------------------------------------------------------------------------
# Analysis and rewrite providers
# ---------------------------------------------------------------------------
# Your OpenRouter key. Stays on this host; clients never see it.
WHISPER_OPENROUTER_API_KEY=
# Comma-separated allow-list; the first entry is the default model.
WHISPER_ANALYSIS_MODELS=openai/gpt-4o-mini
WHISPER_REWRITE_MODELS=
# Hugging Face token for pyannote speaker diarization. Accept the model
# conditions first, and install the extra: pip install '.[diarization]'
HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN is accepted as an alternative to HF_TOKEN.

# ---------------------------------------------------------------------------
# Credentials and stores (paths; defaults are XDG locations)
# ---------------------------------------------------------------------------
# Invite-only user tokens. JSON {"tokens": {"<sha256 of token>": "<user id>"}},
# mode 0600. Issue one with: whisper-server token add --user <id>
WHISPER_TOKENS_FILE=
# Manual paid feature grants, one file per host, mode 0600.
# Grant with: whisper-server entitlement grant --user <id> --feature diarization
WHISPER_ENTITLEMENTS_FILE=
# Bundled plan placeholders the admin portal will own. Falls back to the
# built-in table in whisper_service/plans.py (free: local only; pro: 600 min).
WICX_PLANS_FILE=

# ---------------------------------------------------------------------------
# Billing (only when WHISPER_ENABLE_BILLING=1)
# ---------------------------------------------------------------------------
WHISPER_PAYSTACK_SECRET_KEY=
# Server-owned pricing keyed by plan id. Real approved amounts and plan codes
# belong here, for example:
# WHISPER_PAYSTACK_PLANS={"pro-monthly":{"code":"PLN_xxx","amount_minor":1250,"currency":"GHS","features":["cloud_transcription","diarization"],"cloud_minutes":600}}
WHISPER_PAYSTACK_PLANS=
WHISPER_BILLING_DATABASE=

# ---------------------------------------------------------------------------
# Accounts and OAuth (only when WHISPER_ENABLE_OAUTH=1)
# ---------------------------------------------------------------------------
WHISPER_ACCOUNTS_DATABASE=
WHISPER_OAUTH_DATABASE=
# Public origin of this service, used to build redirect URIs.
WHISPER_OAUTH_BASE_URL=
# Registered deep-link target for the desktop app, e.g. wicx://auth/callback
WHISPER_OAUTH_APP_REDIRECT=wicx://auth/callback
WHISPER_GOOGLE_CLIENT_ID=
WHISPER_GOOGLE_CLIENT_SECRET=
WHISPER_APPLE_CLIENT_ID=
WHISPER_APPLE_TEAM_ID=
WHISPER_APPLE_KEY_ID=
# PEM contents of the Apple private key, or a path to it.
WHISPER_APPLE_PRIVATE_KEY_FILE=

# ---------------------------------------------------------------------------
# Desktop clients (read on the user's machine, not here)
# ---------------------------------------------------------------------------
# Listed so this file documents the whole picture. The bearer token a client
# sends as `Authorization: Bearer <token>` must match a digest in
# WHISPER_TOKENS_FILE above. On the desktop it lives in
# ~/.config/transcriber/keys.env (0600), writable with:
#   wicx set-key --provider hosted-whisper --key <token>
# WHISPER_SERVICE_TOKEN=
# Base URL Wicx posts analysis/diarization to. Leave unset in production to
# derive it from the live URL; set http://127.0.0.1:8766 to test against a
# local `whisper-server serve`.
# WHISPER_SERVICE_API_URL=
# User-Agent Wicx sends. Defaults to Wicx/<version>; override only to satisfy a
# proxy rule, never to imitate a browser.
# WHISPER_SERVICE_USER_AGENT=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=        # client-side rewrite/transcription key, optional
# TRANSCRIBER_KEYS_FILE=     # overrides the client keys.env location
# TRANSCRIBER_CONFIG=        # overrides the client config.yaml location
# XDG_CONFIG_HOME=
# XDG_DATA_HOME=